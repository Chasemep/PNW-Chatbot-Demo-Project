# Copy this file to .env for local development. Never commit real credentials.

# PostgreSQL
POSTGRES_DB=purdue_policy_chatbot
POSTGRES_USER=purdue
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://purdue:change-me@localhost:5432/purdue_policy_chatbot

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Google Gemini answer generation
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=replace-with-approved-model

# Embedding provider
EMBEDDING_API_KEY=replace-with-your-embedding-provider-key
EMBEDDING_MODEL=replace-with-pinned-embedding-model
EMBEDDING_DIMENSION=replace-with-vector-dimension

# Frontend
VITE_API_BASE_URL=http://localhost:8000
