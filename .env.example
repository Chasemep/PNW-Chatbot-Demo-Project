# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=pnw
POSTGRES_PASSWORD=pnwpass
POSTGRES_DB=pnw_assistant

# Full async URL used by the backend service inside Docker
DATABASE_URL=postgresql+asyncpg://pnw:pnwpass@db:5432/pnw_assistant

# ─── LLM & Embeddings ─────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google text-embedding-004 (768 dims) — used for document chunk embeddings
EMBEDDING_MODEL=text-embedding-004

# Local HuggingFace fallback model if Gemini embedding API is unavailable
FALLBACK_HF_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Retrieval ─────────────────────────────────────────────────────────────────
# Cosine DISTANCE threshold: responses with distance >= this value fall back to advisor routing
# (cosine distance 0.35 ≈ cosine similarity 0.65)
COSINE_DISTANCE_THRESHOLD=0.35

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
